# CafePOSPro Environment Variables
# Copy this file to .env.local and update with your values

# Convex Site URL (provided by Convex after deployment)
CONVEX_SITE_URL=https://your-deployment-name.convex.cloud

# Site URL (same as CONVEX_SITE_URL)
SITE_URL=https://your-deployment-name.convex.cloud

# JWT Keys (generated during auth setup)
# These will be automatically generated when you run `npm run deploy:setup`
# JWT_PRIVATE_KEY=your-private-key-here
# JWT_PUBLIC_KEY=your-public-key-here

# Database backup password (for local development)
PGPASSWORD=123