{
  "name": "flex-template",
  "private": true,
  "version": "0.0.0",
  "description": "CafePOSPro - A complete point of sale system for cafes and restaurants",
  "author": "CafePOSPro Team",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "vite --host",
    "dev:backend": "convex dev",
    "build": "vite build",
    "lint": "tsc -p convex -noEmit --pretty false && tsc -p . -noEmit --pretty false && convex dev --once && vite build",
    "electron": "electron .",
    "electron:dev": "electron .",
    "electron:build": "electron-builder",
    "db:backup": "node scripts/backup.cjs",
    "db:backup:info": "node scripts/backup-info.cjs",
    "db:backup:scheduled": "node scripts/scheduled-backup.cjs",
    "db:create-sample-sales": "node scripts/create-sample-sales.cjs",
    "test:app": "node scripts/test-app.mjs",
    "deploy:setup": "npx @convex-dev/auth",
    "deploy": "npx convex deploy",
    "deploy:prod": "npx convex deploy --prod",
    "export:data": "npx convex export --file=backup.zip",
    "import:data": "npx convex import backup.zip",
    "migrate:data": "node scripts/migrate-client-data.cjs",
    "show-ip": "powershell -ExecutionPolicy Bypass -File scripts/get_local_ip.ps1"
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.80",
    "clsx": "^2.1.1",
    "convex": "^1.24.2",
    "date-fns": "^4.1.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "~10",
    "dotenv": "^16.4.7",
    "electron": "^38.4.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "npm-run-all": "^4.1.5",
    "postcss": "~8",
    "prettier": "^3.5.3",
    "tailwindcss": "~3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.cafepospro.manager",
    "productName": "CafePOSPro Manager",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron-main.cjs",
      "electron-preload.js",
      "electron-ui.html",
      "dist/**/*",
      "convex/**/*",
      "package.json",
      "README.md"
    ],
    "extraResources": [
      {
        "from": "scripts/",
        "to": "scripts/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
